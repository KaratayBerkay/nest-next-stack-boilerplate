# Local dev defaults (no .env file needed — Flutter uses these hard-coded defaults)
API_BASE_URL=http://localhost:3001
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
WS_URL=ws://localhost:3001/ws
# Fallback only: the backend stamps its own client-facing LIVEKIT_URL onto every
# join result / call frame and the app prefers that. This value is used solely
# when the server has none configured. Remember `localhost` here is the
# device's own loopback — from an emulator/phone that is never the server (MOB-034).
LIVEKIT_URL=ws://localhost:7880
# Public origin of the companion web app, for share/copy links
WEB_BASE_URL=http://localhost:3000
APP_ENV=development
APP_NAME=flutter-boilerplate
SENTRY_DSN=

# Production preview against mobile.eys.gen.tr (copy this block to .env and uncomment):
# API_BASE_URL=https://mobile.eys.gen.tr
# WS_URL=wss://mobile.eys.gen.tr/ws
# LIVEKIT_URL=wss://livekit.eys.gen.tr
# APP_ENV=development
# APP_NAME=Flutter Boilerplate
